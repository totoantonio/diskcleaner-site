#!/bin/sh

zero_oid="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ] || [ "$remote_oid" = "$zero_oid" ]; then
    continue
  fi

  if ! git diff --quiet "$remote_oid" "$local_oid" -- public/downloads; then
    echo >&2 "ERROR: push blocked because it would change protected files in public/downloads."
    echo >&2 "The published DMG must remain unchanged during normal website pushes."
    exit 1
  fi
done
