{
  "name": "diskcleaner-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generate-static-routes.mjs",
    "snap": "vite preview --port 4567 & sleep 2 && react-snap",
    "predeploy": "npm run build && npm run snap",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "inlineCss": false,
    "source": "dist",
    "include": [
      "/",
      "/privacy-policy",
      "/terms-of-service",
      "/blog",
      "/blog/how-diskcleaner-works",
      "/blog/what-is-system-data-mac",
      "/blog/why-mac-keeps-running-out-of-storage",
      "/blog/become-diskcleaner-affiliate",
      "/blog/why-trash-first-cleanup-matters",
      "/blog/future-of-mac-cleaner-apps",
      "/blog/top-mac-cleaner-apps-ranked",
      "/blog/how-much-space-do-system-logs-take-on-mac",
      "/blog/is-it-safe-to-delete-developer-data-on-mac",
      "/blog/cleanmymac-alternative",
      "/help"
    ],
    "puppeteerArgs": [
      "--no-sandbox"
    ],
    "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "dependencies": {
    "marked": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss7-compat": "^2.2.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "react-snap": "^1.23.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1"
  }
}
